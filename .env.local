# Local environment variables

# Service identity
KAMAL_SERVICE=kamalduo
KAMAL_IMAGE=kamalduo:local

# Local host mapping
KAMAL_WEB_HOSTS=127.0.0.1
APP_HOST=kamalduo.local
APP_PORT=3000

# Registry (local-only, no auth)
KAMAL_REGISTRY_SERVER=localhost
KAMAL_REGISTRY_USERNAME=
KAMAL_REGISTRY_PASSWORD=
